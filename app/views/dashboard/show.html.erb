<% content_for(:title) { "#{library_label} | #{product_name}" } %>
<% @layout_class = "books" %>

<% content_for :header do %>
  <nav>
    <span class="btn btn--placeholder" aria-hidden="true"></span>

    <span class="product__wordmark btn btn--plain txt-large center">
      <%= image_tag "booksend-icon.svg", aria: { hidden: true }, size: 24 %>
      <span><%= product_name %></span>
    </span>

    <%= link_to users_path, class: "btn" do %>
      <%= image_tag "settings.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Manage people and settings</span>
    <% end %>
  </nav>
<% end %>

<% content_for :toolbar do %>
  <nav class="flex align-center justify-center gap-half pad-half">
    <%= link_to marketplace_index_path, class: "btn btn--plain txt-small" do %>
      <%= image_tag "globe.svg", aria: { hidden: true }, size: 18, class: "colorize--black" %>
      <span>Marketplace</span>
    <% end %>

    <%= link_to ad_creatives_path, class: "btn btn--plain txt-small" do %>
      <%= image_tag "page-picture.svg", aria: { hidden: true }, size: 18, class: "colorize--black" %>
      <span>My Ads</span>
    <% end %>

    <% if Current.user.can_administer? %>
      <%= link_to billing_path, class: "btn btn--plain txt-small" do %>
        <%= image_tag "crown.svg", aria: { hidden: true }, size: 18, class: "colorize--black" %>
        <span>Billing</span>
      <% end %>
    <% end %>

    <% if Current.user.platform_admin? %>
      <%= link_to admin_dashboard_path, class: "btn btn--plain txt-small" do %>
        <%= image_tag "lock.svg", aria: { hidden: true }, size: 18, class: "colorize--black" %>
        <span>Admin</span>
      <% end %>
    <% end %>
  </nav>
<% end %>

<div class="library">
  <% if @books.any? %>
    <%= render @books %>
  <% else %>
    <div class="txt-align-center pad-double">
      <p class="txt-large txt-subtle">You don't have any publications yet.</p>
    </div>
  <% end %>
  <%= render "books/new" %>
</div>
