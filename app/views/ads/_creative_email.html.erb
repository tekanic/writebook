<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin: 20px 0; border-left: 3px solid #cccccc; padding-left: 15px;">
  <tr>
    <td style="padding: 15px; background-color: #f8f8f8; border-radius: 4px;">
      <p style="margin: 0 0 5px; font-size: 11px; color: #999;">Sponsored</p>
      <% if creative.image.attached? %>
        <img src="<%= url_for(creative.image) %>" alt="" style="max-width: 100%; border-radius: 4px; margin-bottom: 10px;" />
      <% end %>
      <p style="margin: 0 0 8px; font-size: 16px; font-weight: bold;"><%= sanitize(creative.headline, tags: []) %></p>
      <p style="margin: 0 0 12px; font-size: 14px; color: #555;"><%= sanitize(creative.body_text, tags: []) %></p>
      <a href="<%= click_url %>" style="display: inline-block; padding: 8px 16px; background-color: #0066cc; color: #ffffff; text-decoration: none; border-radius: 4px; font-size: 14px;"><%= sanitize(creative.cta_text, tags: []) %></a>
      <p style="margin: 10px 0 0; font-size: 11px; color: #999;"><%= sanitize(creative.advertiser_name, tags: []) %></p>
    </td>
  </tr>
</table>
