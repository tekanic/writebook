<% content_for(:title) { @issue.subject } %>

<% content_for :header do %>
  <nav>
    <%= link_to book_issues_path(@book), class: "btn flex-item-justify-start" do %>
      <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Back to issues</span>
    <% end %>

    <div class="breadcrumbs">
      <strong><%= @issue.subject %></strong>
    </div>
  </nav>
<% end %>

<div class="panel borderless center pad margin-block">
  <div class="flex align-center justify-space-between margin-block-end">
    <div>
      <h1><%= @issue.subject %></h1>
      <p class="txt-subtle">
        <span class="badge"><%= @issue.status.titleize %></span>
        <% if @issue.preview_text.present? %>
          · <%= @issue.preview_text %>
        <% end %>
      </p>
    </div>

    <div class="flex align-center gap-half">
      <%= link_to edit_book_issue_path(@book, @issue), class: "btn" do %>
        <%= image_tag "pencil.svg", aria: { hidden: true }, size: 24 %>
        <span class="for-screen-reader">Edit</span>
      <% end %>

      <% if @issue.draft? %>
        <%= button_to send_campaign_book_issue_path(@book, @issue),
              method: :post,
              class: "btn btn--positive",
              data: { turbo_confirm: "Send this issue to all subscribers?" } do %>
          <%= image_tag "arrow-right.svg", aria: { hidden: true }, size: 24 %>
          <span>Send Now</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @issue.articles.any? %>
    <h2 class="txt-medium margin-block-end-half">Articles in this issue</h2>
    <div class="flex flex-column gap-half">
      <% @issue.articles.each do |article| %>
        <div class="pad-half fill-shade border-radius">
          <strong><%= article.title %></strong>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @issue.campaigns.any? %>
    <h2 class="txt-medium margin-block margin-block-end-half">Campaign Results</h2>
    <% @issue.campaigns.each do |campaign| %>
      <div class="pad fill-shade border-radius flex gap-double">
        <div><strong>Status:</strong> <%= campaign.status.titleize %></div>
        <div><strong>Sent:</strong> <%= campaign.sent_count %></div>
        <div><strong>Opens:</strong> <%= campaign.open_count %> (<%= campaign.open_rate %>%%)</div>
        <div><strong>Clicks:</strong> <%= campaign.click_count %> (<%= campaign.click_rate %>%%)</div>
        <div><strong>Bounces:</strong> <%= campaign.bounce_count %></div>
      </div>
    <% end %>
  <% end %>
</div>
