<% content_for(:title) { "Generated Articles — #{@book.title}" } %>

<% content_for :header do %>
  <nav>
    <%= link_to book_slug_path(@book), class: "btn flex-item-justify-start" do %>
      <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Back to publication</span>
    <% end %>

    <div class="breadcrumbs">
      <%= render "books/index_link" %>
      <span class="flex-item-no-shrink">▸</span>
      <strong>Generated Articles</strong>
    </div>
  </nav>
<% end %>

<div class="panel borderless center pad margin-block">
  <h1>Generated Articles</h1>
  <p class="txt-subtle margin-block-end">AI-generated articles awaiting your review.</p>

  <% pending = @generated_articles.select(&:pending?) %>
  <% published = @generated_articles.select(&:published?) %>

  <% if pending.any? %>
    <h2 class="txt-medium margin-block-end-half">Pending Review (<%= pending.size %>)</h2>
    <div class="flex flex-column gap-half margin-block-end">
      <% pending.each do |article| %>
        <div class="flex align-center gap pad-half fill-shade border-radius">
          <div class="flex-item-grow">
            <%= link_to article.title, book_generated_article_path(@book, article) %>
            <div class="txt-small txt-subtle"><%= time_ago_in_words(article.created_at) %> ago · <%= article.ai_model_used %></div>
          </div>
          <div class="flex align-center gap-half">
            <%= button_to "Publish", publish_book_generated_article_path(@book, article), method: :post, class: "btn btn--small btn--positive" %>
            <%= button_to "Reject", reject_book_generated_article_path(@book, article), method: :post, class: "btn btn--small btn--negative" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if published.any? %>
    <h2 class="txt-medium margin-block-end-half">Published (<%= published.size %>)</h2>
    <div class="flex flex-column gap-half">
      <% published.each do |article| %>
        <div class="flex align-center gap pad-half fill-shade border-radius">
          <div class="flex-item-grow">
            <%= link_to article.title, book_generated_article_path(@book, article) %>
            <div class="txt-small txt-subtle">Published · <%= article.ai_model_used %></div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @generated_articles.empty? %>
    <p class="txt-subtle">No generated articles yet. Add an <%= link_to "AI source", book_article_sources_path(@book) %> to get started.</p>
  <% end %>
</div>
