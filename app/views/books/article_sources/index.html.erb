<% content_for(:title) { "AI Sources — #{@book.title}" } %>

<% content_for :header do %>
  <nav>
    <%= link_to book_slug_path(@book), class: "btn flex-item-justify-start" do %>
      <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Back to publication</span>
    <% end %>

    <div class="breadcrumbs">
      <%= render "books/index_link" %>
      <span class="flex-item-no-shrink">▸</span>
      <strong>AI Sources</strong>
    </div>
  </nav>
<% end %>

<div class="panel borderless center pad margin-block">
  <div class="flex align-center justify-space-between margin-block-end">
    <h1>AI Article Sources</h1>
    <%= link_to new_book_article_source_path(@book), class: "btn btn--positive txt-small" do %>
      <%= image_tag "add.svg", aria: { hidden: true }, size: 16 %>
      <span>Add Source</span>
    <% end %>
  </div>

  <% if @article_sources.any? %>
    <div class="flex flex-column gap-half">
      <% @article_sources.each do |source| %>
        <div class="flex align-center gap pad-half fill-shade border-radius">
          <div class="flex-item-grow">
            <%= link_to source.name, book_article_source_path(@book, source), class: "txt-medium" %>
            <div class="txt-small txt-subtle">
              <%= source.url %> · <%= source.fetch_frequency.titleize %>
              · <span class="badge"><%= source.status.titleize %></span>
              <% if source.last_fetched_at %>
                · Last fetched: <%= time_ago_in_words(source.last_fetched_at) %> ago
              <% end %>
            </div>
          </div>
          <div class="flex align-center gap-half">
            <%= link_to edit_book_article_source_path(@book, source), class: "btn btn--small" do %>
              <%= image_tag "pencil.svg", aria: { hidden: true }, size: 16 %>
            <% end %>
            <%= button_to book_article_source_path(@book, source), method: :delete, class: "btn btn--small btn--negative", data: { turbo_confirm: "Remove this source?" } do %>
              <%= image_tag "trash.svg", aria: { hidden: true }, size: 16 %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="txt-subtle">No AI sources yet. Add a URL to automatically generate articles from web content.</p>
  <% end %>
</div>
