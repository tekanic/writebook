<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Preview — <%= @book.title %></title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4;">
  <% if !@book.published? %>
    <div style="background: #fff3cd; color: #856404; padding: 10px 20px; text-align: center; font-family: Arial, sans-serif; font-size: 14px;">
      DRAFT — This content has not been published yet.
    </div>
  <% end %>

  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f4f4f4;">
    <tr>
      <td align="center" style="padding: 20px 0;">
        <table role="presentation" cellpadding="0" cellspacing="0" width="600" style="max-width: 600px; width: 100%;">
          <tr>
            <td style="background-color: <%= @branding&.accent_color || '#0066cc' %>; padding: 30px 20px; border-radius: 8px 8px 0 0; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-family: Arial, sans-serif; font-size: 28px;">
                <%= @branding&.from_name.presence || @book.title %>
              </h1>
            </td>
          </tr>
          <tr>
            <td style="background-color: #ffffff; padding: 30px; font-family: Arial, sans-serif; font-size: 16px; line-height: 1.6; color: #333;">
              <%= raw @html_content %>
            </td>
          </tr>
          <tr>
            <td style="padding: 20px; text-align: center; color: #999; font-size: 12px; border-top: 1px solid #eee; background: #fff; border-radius: 0 0 8px 8px;">
              <p><%= @branding&.footer_text %></p>
              <p>Unsubscribe | View in browser</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
